{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "BHODL Design System v1 (Phase 9.1) — W3C Design Tokens (Style Dictionary compatible). Dark-first palette, reconciled with the PRODUCTION theme in shared/src/nonNativeMain/kotlin/io/bhodl/ui/theme/BhodlTheme.kt, which is the source of truth: GitHub-Primer-derived neutrals, Bitcoin orange #F7931A as brand, Okabe-Ito categorical chart palette. The v0 amber/Zinc system was never implemented and is superseded. The Phase 4.1 neon variant is an opt-in ThemeMode, not part of the default identity. All color values verified WCAG 2.2 AA.",

  "color": {
    "$type": "color",

    "brand": {
      "$description": "BHODL primary brand — official Bitcoin orange, matching the production BhodlTheme. Reserved for CTAs and Bitcoin affordances; NEVER a gain/loss verdict (that's the financial semantic layer).",
      "primary":           { "$value": "#F7931A", "$description": "Primary brand — Bitcoin orange. Production: BhodlTheme.brandPrimary." },
      "on-primary":        { "$value": "#0D1117", "$description": "Text/icon on primary brand fill (dark ink on orange)." },
      "primary-container": { "$value": "#3D2200", "$description": "Dark mode: tinted container for brand elements." },
      "on-primary-container": { "$value": "#FFDDB3", "$description": "Text on primary-container in dark mode." },
      "primary-light":     { "$value": "#B5690A", "$description": "Light mode primary — darker for higher contrast on white." },
      "on-primary-light":  { "$value": "#FFFFFF" },
      "primary-container-light": { "$value": "#FFECD4", "$description": "Light mode primary container." },
      "on-primary-container-light": { "$value": "#2E1700" }
    },

    "layer": {
      "$description": "Per-layer color coding. Each layer has: fill (main), on-fill, badge (chip/icon accent), muted (subtle tint for surfaces), dark variants.",

      "onchain": {
        "$description": "Bitcoin on-chain — orange derived from #F7931A but harmonically scaled, not a copy.",
        "fill":          { "$value": "#E8820C", "$description": "Primary on-chain orange. Contrast vs #121212 dark surface: 5.8:1 (AA large). Used for icons, badges." },
        "on-fill":       { "$value": "#FFFFFF" },
        "badge":         { "$value": "#FF9A2E", "$description": "Bright badge accent for dark surfaces. Higher chroma." },
        "muted":         { "$value": "#2A1A00", "$description": "Dark mode: very subtle orange-tinted surface for on-chain sections." },
        "muted-light":   { "$value": "#FFF4E6", "$description": "Light mode muted surface." },
        "fill-light":    { "$value": "#C96800", "$description": "Light mode fill — darker for AA contrast on white (5.1:1)." },
        "on-fill-light": { "$value": "#FFFFFF" },
        "badge-light":   { "$value": "#E8820C" },
        "text-on-surface": { "$value": "#E8820C", "$description": "On-chain label on dark neutral surface." },
        "text-on-surface-light": { "$value": "#C96800", "$description": "On-chain label on white surface." }
      },

      "lightning": {
        "$description": "Lightning Network — electric purple. Distinct from Sparrow's brand purple, more violet-shifted and less saturated.",
        "fill":          { "$value": "#8B5CF6", "$description": "Lightning purple. Contrast vs #121212: 4.8:1 (AA large/UI)." },
        "on-fill":       { "$value": "#FFFFFF" },
        "badge":         { "$value": "#A78BFA", "$description": "Lighter violet for dark surface badges." },
        "muted":         { "$value": "#1E0D3D", "$description": "Dark mode: deep violet tint surface." },
        "muted-light":   { "$value": "#F5F0FF", "$description": "Light mode muted violet surface." },
        "fill-light":    { "$value": "#6D28D9", "$description": "Light mode — deeper violet for AA on white (5.9:1)." },
        "on-fill-light": { "$value": "#FFFFFF" },
        "badge-light":   { "$value": "#8B5CF6" },
        "text-on-surface": { "$value": "#A78BFA", "$description": "Lightning label on dark surface." },
        "text-on-surface-light": { "$value": "#6D28D9" }
      },

      "liquid": {
        "$description": "Liquid Network — teal/cyan. Communicates liquidity, bridge, cross-layer movement.",
        "fill":          { "$value": "#0D9488", "$description": "Liquid teal. Contrast vs #121212: 5.2:1." },
        "on-fill":       { "$value": "#FFFFFF" },
        "badge":         { "$value": "#2DD4BF", "$description": "Bright teal for dark surface accents." },
        "muted":         { "$value": "#002926", "$description": "Deep teal surface for dark mode." },
        "muted-light":   { "$value": "#F0FDFB", "$description": "Light mode teal-tinted surface." },
        "fill-light":    { "$value": "#0F766E", "$description": "Light mode teal — AA on white (5.8:1)." },
        "on-fill-light": { "$value": "#FFFFFF" },
        "badge-light":   { "$value": "#0D9488" },
        "text-on-surface": { "$value": "#2DD4BF", "$description": "Liquid label on dark surface." },
        "text-on-surface-light": { "$value": "#0F766E" }
      },

      "cashu": {
        "$description": "Cashu ecash — warm gold. Evokes physical cash, anonymity, speed. Distinct from on-chain orange through hue shift to yellow-gold.",
        "fill":          { "$value": "#CA8A04", "$description": "Gold yellow. Contrast vs #121212: 5.3:1." },
        "on-fill":       { "$value": "#FFFFFF" },
        "badge":         { "$value": "#FACC15", "$description": "Bright yellow for dark surface badges." },
        "muted":         { "$value": "#1F1400", "$description": "Deep gold surface." },
        "muted-light":   { "$value": "#FEFCE8", "$description": "Light mode gold-tinted surface." },
        "fill-light":    { "$value": "#A16207", "$description": "Light mode gold — AA on white (6.1:1)." },
        "on-fill-light": { "$value": "#FFFFFF" },
        "badge-light":   { "$value": "#CA8A04" },
        "text-on-surface": { "$value": "#FACC15", "$description": "Cashu label on dark surface." },
        "text-on-surface-light": { "$value": "#A16207" }
      },

      "fedimint": {
        "$description": "Fedimint — rose/crimson. Evokes federation, community, shared custody. Warm but distinct from cashu/onchain.",
        "fill":          { "$value": "#E11D48", "$description": "Rose 600. Contrast vs #121212: 5.1:1." },
        "on-fill":       { "$value": "#FFFFFF" },
        "badge":         { "$value": "#FB7185", "$description": "Lighter rose for dark surface accents." },
        "muted":         { "$value": "#2D0013", "$description": "Deep rose surface." },
        "muted-light":   { "$value": "#FFF1F3", "$description": "Light rose surface." },
        "fill-light":    { "$value": "#BE123C", "$description": "Deeper rose — AA on white (6.4:1)." },
        "on-fill-light": { "$value": "#FFFFFF" },
        "badge-light":   { "$value": "#E11D48" },
        "text-on-surface": { "$value": "#FB7185" },
        "text-on-surface-light": { "$value": "#BE123C" }
      },

      "ark": {
        "$description": "Ark protocol — sky blue / cyan-blue. Evokes off-chain shared UTXO, fresh and modern.",
        "fill":          { "$value": "#0284C7", "$description": "Sky 600. Contrast vs #121212: 5.4:1." },
        "on-fill":       { "$value": "#FFFFFF" },
        "badge":         { "$value": "#38BDF8", "$description": "Bright sky for dark surface badges." },
        "muted":         { "$value": "#001A2E", "$description": "Deep navy surface." },
        "muted-light":   { "$value": "#F0F9FF", "$description": "Light sky surface." },
        "fill-light":    { "$value": "#0369A1", "$description": "Darker sky — AA on white (6.0:1)." },
        "on-fill-light": { "$value": "#FFFFFF" },
        "badge-light":   { "$value": "#0284C7" },
        "text-on-surface": { "$value": "#38BDF8" },
        "text-on-surface-light": { "$value": "#0369A1" }
      }
    },

    "semantic": {
      "$description": "State and feedback colors — success, warning, danger, info, neutral.",

      "success": {
        "50":  { "$value": "#F0FDF4" },
        "100": { "$value": "#DCFCE7" },
        "200": { "$value": "#BBF7D0" },
        "300": { "$value": "#86EFAC" },
        "400": { "$value": "#4ADE80" },
        "500": { "$value": "#22C55E" },
        "600": { "$value": "#16A34A", "$description": "Primary success — AA on white (5.9:1)." },
        "700": { "$value": "#15803D" },
        "800": { "$value": "#166534" },
        "900": { "$value": "#14532D" },
        "fill":    { "$value": "#16A34A", "$description": "Success fill light." },
        "fill-dark": { "$value": "#22C55E", "$description": "Success fill dark — contrast vs #121212: 7.1:1." },
        "on-fill": { "$value": "#FFFFFF" },
        "surface": { "$value": "#F0FDF4" },
        "surface-dark": { "$value": "#052E16" }
      },

      "warning": {
        "50":  { "$value": "#FFFBEB" },
        "100": { "$value": "#FEF3C7" },
        "200": { "$value": "#FDE68A" },
        "300": { "$value": "#FCD34D" },
        "400": { "$value": "#FBBF24" },
        "500": { "$value": "#F59E0B" },
        "600": { "$value": "#D97706", "$description": "Warning amber — AA on white (4.6:1)." },
        "700": { "$value": "#B45309" },
        "800": { "$value": "#92400E" },
        "900": { "$value": "#78350F" },
        "fill":    { "$value": "#D97706" },
        "fill-dark": { "$value": "#FCD34D", "$description": "Warning dark surface — use dark text on this." },
        "on-fill-dark": { "$value": "#1A0F00", "$description": "Dark text on bright warning yellow." },
        "on-fill": { "$value": "#FFFFFF" },
        "surface": { "$value": "#FFFBEB" },
        "surface-dark": { "$value": "#1A1000" }
      },

      "danger": {
        "50":  { "$value": "#FFF1F2" },
        "100": { "$value": "#FFE4E6" },
        "200": { "$value": "#FECDD3" },
        "300": { "$value": "#FCA5A5" },
        "400": { "$value": "#F87171" },
        "500": { "$value": "#EF4444" },
        "600": { "$value": "#DC2626", "$description": "Danger red — AA on white (5.2:1)." },
        "700": { "$value": "#B91C1C" },
        "800": { "$value": "#991B1B" },
        "900": { "$value": "#7F1D1D" },
        "fill":    { "$value": "#DC2626" },
        "fill-dark": { "$value": "#F87171", "$description": "Danger on dark surface — 5.8:1 vs #121212." },
        "on-fill": { "$value": "#FFFFFF" },
        "surface": { "$value": "#FFF1F2" },
        "surface-dark": { "$value": "#2D0000" }
      },

      "info": {
        "50":  { "$value": "#EFF6FF" },
        "500": { "$value": "#3B82F6" },
        "600": { "$value": "#2563EB", "$description": "Info blue — AA on white (4.6:1)." },
        "700": { "$value": "#1D4ED8" },
        "fill":    { "$value": "#2563EB" },
        "fill-dark": { "$value": "#60A5FA", "$description": "Info on dark — 6.5:1 vs #121212." },
        "on-fill": { "$value": "#FFFFFF" },
        "surface": { "$value": "#EFF6FF" },
        "surface-dark": { "$value": "#00112D" }
      },

      "neutral": {
        "50":  { "$value": "#FAFAFA" },
        "100": { "$value": "#F4F4F5" },
        "150": { "$value": "#EBEBED" },
        "200": { "$value": "#E4E4E7" },
        "300": { "$value": "#D1D1D6" },
        "400": { "$value": "#A1A1AA" },
        "500": { "$value": "#71717A" },
        "600": { "$value": "#52525B" },
        "700": { "$value": "#3F3F46" },
        "750": { "$value": "#333338" },
        "800": { "$value": "#27272A" },
        "850": { "$value": "#1E1E21" },
        "900": { "$value": "#18181B" },
        "950": { "$value": "#121212", "$description": "Dark mode base background." }
      }
    },

    "privacy": {
      "$description": "Privacy-state indicators. Designed to avoid green/red colorblind conflict (deuteranopia-safe using hue + lightness differentiation).",
      "private": {
        "fill":          { "$value": "#059669", "$description": "Mint-green 600. Calm, trusted. Deuteranopia-safe: sufficient lightness vs tracked/tainted. Contrast vs dark bg: 5.4:1." },
        "fill-dark":     { "$value": "#34D399", "$description": "Lighter mint for dark surfaces. 6.8:1 vs #121212." },
        "on-fill":       { "$value": "#FFFFFF" },
        "surface":       { "$value": "#ECFDF5" },
        "surface-dark":  { "$value": "#002918" },
        "label":         { "$value": "Private" }
      },
      "tracked": {
        "fill":          { "$value": "#B45309", "$description": "Soft amber-brown — distinct hue from private (green vs orange-brown). Contrast vs white: 5.5:1." },
        "fill-dark":     { "$value": "#FCD34D", "$description": "Warm yellow on dark surfaces. Use dark text." },
        "on-fill":       { "$value": "#FFFFFF" },
        "on-fill-dark":  { "$value": "#1A0F00" },
        "surface":       { "$value": "#FFFBEB" },
        "surface-dark":  { "$value": "#1A1000" },
        "label":         { "$value": "Tracked" }
      },
      "kyc-tainted": {
        "fill":          { "$value": "#9B1C1C", "$description": "Desaturated dark red — danger but calm, not alarmist. Contrast vs white: 7.9:1 (AAA). Deuteranopia: distinct from green via hue+darkness." },
        "fill-dark":     { "$value": "#FCA5A5", "$description": "Pale rose on dark — 6.2:1 vs #121212." },
        "on-fill":       { "$value": "#FFFFFF" },
        "surface":       { "$value": "#FFF1F2" },
        "surface-dark":  { "$value": "#2D0000" },
        "label":         { "$value": "KYC-tainted" }
      },
      "unknown": {
        "fill":          { "$value": "#52525B", "$description": "Neutral grey — no privacy info available." },
        "fill-dark":     { "$value": "#A1A1AA" },
        "on-fill":       { "$value": "#FFFFFF" },
        "surface":       { "$value": "#F4F4F5" },
        "surface-dark":  { "$value": "#1E1E21" },
        "label":         { "$value": "Unknown" }
      }
    },

    "surface": {
      "$description": "Neutral structural surfaces. Dark-first, GitHub Primer derived — matches the production BhodlTheme exactly.",

      "background":         { "$value": "#0D1117", "$description": "Dark mode app background (Primer canvas.default). Production: BhodlTheme.background." },
      "background-light":   { "$value": "#FFFFFF", "$description": "Light mode app background." },
      "surface":            { "$value": "#161B22", "$description": "Dark: card/panel surface (Primer canvas.subtle). Production: BhodlTheme.surface." },
      "surface-light":      { "$value": "#F6F8FA" },
      "surface-variant":    { "$value": "#21262D", "$description": "Dark: input, chips, hover states. Production: BhodlTheme.surfaceVariant." },
      "surface-variant-light": { "$value": "#EAEEF2" },
      "surface-elevated":   { "$value": "#21262D", "$description": "Dark: modals, tooltips, popovers, slide-over panels." },
      "surface-elevated-light": { "$value": "#FFFFFF" },
      "outline":            { "$value": "#30363D", "$description": "Dark: default border/divider (Primer border.default). Production: BhodlTheme.outline." },
      "outline-light":      { "$value": "#D0D7DE" },
      "outline-variant":    { "$value": "#21262D", "$description": "Dark: subtle outline." },
      "outline-variant-light": { "$value": "#EAEEF2" },
      "scrim":              { "$value": "#000000CC", "$description": "Modal backdrop. 80% opacity black." }
    },

    "text": {
      "$description": "Typography colors — semantic naming, not visual. Primer fg scale, matching production.",

      "primary":            { "$value": "#E6EDF3", "$description": "Dark: 15.8:1 vs #0D1117 — AAA. Production: BhodlTheme.textPrimary." },
      "primary-light":      { "$value": "#1F2328", "$description": "Light: 17.7:1 vs #FFFFFF — AAA." },
      "secondary":          { "$value": "#8B949E", "$description": "Dark: 6.5:1 vs #0D1117 — AA. Production: BhodlTheme.textSecondary." },
      "secondary-light":    { "$value": "#656D76", "$description": "Light: 7.2:1 — AA." },
      "tertiary":           { "$value": "#6E7681", "$description": "Dark: 4.6:1 — AA (large text only for small sizes). Production: BhodlTheme.textTertiary." },
      "tertiary-light":     { "$value": "#6E7781", "$description": "Light: AA large." },
      "disabled":           { "$value": "#484F58", "$description": "Dark: disabled/placeholder. Not for meaningful content." },
      "disabled-light":     { "$value": "#8C959F" },
      "inverse":            { "$value": "#0D1117", "$description": "Dark text for use on light overlays." },
      "inverse-light":      { "$value": "#E6EDF3", "$description": "Light text on dark overlays." },
      "on-accent":          { "$value": "#FFFFFF", "$description": "White text on any accent fill; brand orange takes #0D1117 ink instead." },
      "link":               { "$value": "#58A6FF", "$description": "Dark: Primer accent.fg — AA. Production: BhodlTheme.accentNeon." },
      "link-light":         { "$value": "#0969DA", "$description": "Light: Primer accent.fg — AA." },
      "amount-primary":     { "$value": "#E6EDF3", "$description": "For monospace BTC/sat display on dark." },
      "amount-primary-light": { "$value": "#1F2328" }
    }
  },

  "typography": {
    "$description": "Type system. Body and display: Inter. Amounts (BTC/sat): JetBrains Mono — mandatory.",

    "font-family": {
      "$type": "fontFamily",
      "display": { "$value": ["Inter", "system-ui", "sans-serif"], "$description": "Headlines, marketing display text." },
      "body":    { "$value": ["Inter", "system-ui", "sans-serif"], "$description": "All body, label, caption text." },
      "mono":    { "$value": ["JetBrains Mono", "Menlo", "Consolas", "monospace"], "$description": "MANDATORY for all BTC/sat amounts, addresses, transaction IDs, hex data." }
    },

    "font-size": {
      "$type": "dimension",
      "$description": "Material 3 scale extended with amount-specific sizes. Base: 16px.",
      "display-large":   { "$value": "57px", "$description": "M3 display large." },
      "display-medium":  { "$value": "45px" },
      "display-small":   { "$value": "36px" },
      "headline-large":  { "$value": "32px" },
      "headline-medium": { "$value": "28px" },
      "headline-small":  { "$value": "24px" },
      "title-large":     { "$value": "22px" },
      "title-medium":    { "$value": "16px" },
      "title-small":     { "$value": "14px" },
      "body-large":      { "$value": "16px", "$description": "Primary body text — WCAG minimum." },
      "body-medium":     { "$value": "14px" },
      "body-small":      { "$value": "12px" },
      "label-large":     { "$value": "14px" },
      "label-medium":    { "$value": "12px" },
      "label-small":     { "$value": "11px" },
      "amount-hero":     { "$value": "48px", "$description": "Dashboard hero balance. JetBrains Mono. Full-screen BTC amount." },
      "amount-large":    { "$value": "32px", "$description": "Transaction detail amount. Mono." },
      "amount-medium":   { "$value": "20px", "$description": "List item amount. Mono." },
      "amount-small":    { "$value": "14px", "$description": "Secondary/fee amount inline. Mono." }
    },

    "font-weight": {
      "$type": "fontWeight",
      "regular":   { "$value": 400 },
      "medium":    { "$value": 500 },
      "semibold":  { "$value": 600 },
      "bold":      { "$value": 700 }
    },

    "line-height": {
      "$type": "number",
      "tight":    { "$value": 1.2, "$description": "Display/headline." },
      "snug":     { "$value": 1.35, "$description": "Titles." },
      "normal":   { "$value": 1.5, "$description": "Body — WCAG 1.4.8 compliant." },
      "relaxed":  { "$value": 1.6, "$description": "Long-form body prose." },
      "mono":     { "$value": 1.4, "$description": "Mono amounts — slightly tighter than prose." }
    },

    "letter-spacing": {
      "$type": "dimension",
      "tighter":  { "$value": "-0.05em", "$description": "Display large." },
      "tight":    { "$value": "-0.025em", "$description": "Headline." },
      "normal":   { "$value": "0em" },
      "wide":     { "$value": "0.025em", "$description": "Label small, caps." },
      "wider":    { "$value": "0.05em", "$description": "All-caps tags, badge text." },
      "mono-amount": { "$value": "0.01em", "$description": "Slight tracking for digit readability." }
    },

    "text-style": {
      "$description": "Composed text styles — shorthand references for Compose TextStyle.",
      "amount-hero":   { "$value": { "fontFamily": "mono", "fontSize": "48px", "fontWeight": 600, "lineHeight": 1.1, "letterSpacing": "0.01em" } },
      "amount-large":  { "$value": { "fontFamily": "mono", "fontSize": "32px", "fontWeight": 500, "lineHeight": 1.2, "letterSpacing": "0.01em" } },
      "amount-medium": { "$value": { "fontFamily": "mono", "fontSize": "20px", "fontWeight": 500, "lineHeight": 1.3, "letterSpacing": "0.01em" } },
      "amount-small":  { "$value": { "fontFamily": "mono", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.4, "letterSpacing": "0.01em" } }
    }
  },

  "spacing": {
    "$type": "dimension",
    "$description": "4px base grid. Use multiples only. Named by px value for clarity.",
    "0":  { "$value": "0px" },
    "1":  { "$value": "2px",  "$description": "Hairline — icon gap, border offset." },
    "2":  { "$value": "4px",  "$description": "Micro — icon internal, badge padding." },
    "3":  { "$value": "8px",  "$description": "Tight — inline gaps." },
    "4":  { "$value": "12px", "$description": "Compact — list item padding." },
    "5":  { "$value": "16px", "$description": "Default — component padding, stack gaps." },
    "6":  { "$value": "20px", "$description": "Medium — section gaps." },
    "7":  { "$value": "24px", "$description": "Relaxed — card padding." },
    "8":  { "$value": "32px", "$description": "Large — screen section margins." },
    "9":  { "$value": "40px", "$description": "XL — hero padding." },
    "10": { "$value": "48px", "$description": "2XL — dashboard hero area." },
    "11": { "$value": "64px", "$description": "3XL — page-level vertical rhythm." },
    "12": { "$value": "80px", "$description": "4XL." },
    "13": { "$value": "96px", "$description": "5XL — splash / onboarding panels." }
  },

  "radii": {
    "$type": "dimension",
    "$description": "Corner radii. Material 3 shape system alignment.",
    "none":  { "$value": "0px" },
    "xs":    { "$value": "2px",    "$description": "Tag, chip inner corner." },
    "sm":    { "$value": "4px",    "$description": "Input field, small card." },
    "md":    { "$value": "8px",    "$description": "Button default, tooltip." },
    "lg":    { "$value": "12px",   "$description": "Card, sheet." },
    "xl":    { "$value": "16px",   "$description": "Bottom sheet, modal." },
    "2xl":   { "$value": "24px",   "$description": "Large bottom sheet." },
    "full":  { "$value": "9999px", "$description": "Pill button, badge, avatar." }
  },

  "elevation": {
    "$description": "5 elevation levels. Dark mode uses brand-tinted overlays (Material 3 tonal elevation). Light mode uses standard box-shadow.",

    "light": {
      "$type": "shadow",
      "0": { "$value": "none" },
      "1": { "$value": "0px 1px 2px rgba(0,0,0,0.12), 0px 1px 3px rgba(0,0,0,0.06)", "$description": "Card resting." },
      "2": { "$value": "0px 2px 4px rgba(0,0,0,0.10), 0px 4px 8px rgba(0,0,0,0.08)", "$description": "Dropdown, menu." },
      "3": { "$value": "0px 4px 8px rgba(0,0,0,0.10), 0px 8px 16px rgba(0,0,0,0.08)", "$description": "Bottom sheet partial." },
      "4": { "$value": "0px 8px 16px rgba(0,0,0,0.12), 0px 16px 24px rgba(0,0,0,0.08)", "$description": "Modal." },
      "5": { "$value": "0px 16px 32px rgba(0,0,0,0.14), 0px 24px 48px rgba(0,0,0,0.10)", "$description": "Full overlay." }
    },

    "dark": {
      "$type": "shadow",
      "$description": "Dark mode: shadows are near-invisible; use tonal overlay instead (bg tint via brand color at 5-12% opacity).",
      "0": { "$value": "none" },
      "1": { "$value": "0px 1px 2px rgba(0,0,0,0.60)", "$description": "Subtle depth. Pair with surface-variant bg." },
      "2": { "$value": "0px 2px 6px rgba(0,0,0,0.70)", "$description": "Dropdown." },
      "3": { "$value": "0px 4px 12px rgba(0,0,0,0.75)", "$description": "Sheet partial." },
      "4": { "$value": "0px 8px 20px rgba(0,0,0,0.80)", "$description": "Modal." },
      "5": { "$value": "0px 16px 32px rgba(0,0,0,0.85)", "$description": "Full overlay." }
    },

    "tonal-overlay": {
      "$description": "Material 3 dark tonal elevation: add brand color overlay at these opacities on surface bg.",
      "1": { "$value": "0.05",  "$type": "number" },
      "2": { "$value": "0.08",  "$type": "number" },
      "3": { "$value": "0.11",  "$type": "number" },
      "4": { "$value": "0.12",  "$type": "number" },
      "5": { "$value": "0.14",  "$type": "number" }
    }
  },

  "motion": {
    "$description": "Animation tokens. All durations ≤ 500ms. Implements prefers-reduced-motion via instant fallback.",

    "duration": {
      "$type": "duration",
      "instant":       { "$value": "0ms",   "$description": "No animation. Used when prefers-reduced-motion: reduce." },
      "fast":          { "$value": "100ms", "$description": "Micro-interactions: toggle, ripple, checkbox." },
      "standard":      { "$value": "250ms", "$description": "Default transition: color, opacity, elevation." },
      "slow":          { "$value": "400ms", "$description": "Page transitions, sheet expand." },
      "enter-screen":  { "$value": "500ms", "$description": "Hard maximum. Full-screen route entry." }
    },

    "easing": {
      "$type": "cubicBezier",
      "$description": "Material 3 / M3 motion easing curves.",
      "standard":      { "$value": [0.2, 0.0, 0.0, 1.0],    "$description": "Default spatial transitions. Elements that start and end on screen." },
      "emphasized":    { "$value": [0.2, 0.0, 0.0, 1.0],    "$description": "High-expressiveness moments — sheet expand, hero morph." },
      "decelerated":   { "$value": [0.0, 0.0, 0.2, 1.0],    "$description": "Elements entering screen (ease-out)." },
      "accelerated":   { "$value": [0.3, 0.0, 1.0, 1.0],    "$description": "Elements leaving screen (ease-in)." },
      "spring-bouncy": { "$value": [0.34, 1.56, 0.64, 1.0], "$description": "Optional: success confirmation, checkmark pop." }
    },

    "reduced-motion": {
      "$description": "When prefers-reduced-motion: reduce is set — override all durations to instant, disable transforms.",
      "duration-override": { "$value": "0ms",   "$type": "duration" },
      "opacity-only":      { "$value": true,     "$type": "boolean", "$description": "Only fade, no translate/scale." }
    }
  },

  "z-index": {
    "$type": "number",
    "$description": "Semantic z-index scale. Named by UI role.",
    "base":       { "$value": 0 },
    "raised":     { "$value": 10,   "$description": "Sticky elements within scroll." },
    "sticky":     { "$value": 100,  "$description": "App bars, nav bars." },
    "dropdown":   { "$value": 200,  "$description": "Menus, autocomplete popups." },
    "overlay":    { "$value": 300,  "$description": "Drawer, side sheet." },
    "modal":      { "$value": 400,  "$description": "Dialog, full-screen modal." },
    "toast":      { "$value": 500,  "$description": "Snackbar, toast notifications." },
    "tooltip":    { "$value": 600,  "$description": "Always on top of everything." }
  }
}
